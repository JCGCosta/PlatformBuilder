@base <http://www.cedri.com/DBMMarketPricing#> .

#################################################################
#    Prefixes
#################################################################

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Ontological framework
@prefix md:  <http://www.cedri.com/OntologyToAPI-Metadata#> .
@prefix comm:  <http://www.cedri.com/OntologyToAPI-Communications#> .
@prefix bm:  <http://www.cedri.com/OntologyToAPI-BusinessModel#> .
@prefix excode:  <http://www.cedri.com/OntologyToAPI-ExternalCode#> .
@prefix PlatformBuilder: <http://www.cedri.com/PlatformBuilder#> .

# This ontology
@prefix DBMMarketPricing: <http://www.cedri.com/DBMMarketPricing#> .

#################################################################
#    Ontology
#################################################################

<http://www.cedri.com/DBMMarketPricing> rdf:type owl:Ontology ;
                              owl:versionIRI <http://www.cedri.com/DBMMarketPricing/1.0.0> ;
                              owl:imports <http://www.cedri.com/OntologyToAPI-Metadata/1.0.0> ,
                                          <http://www.cedri.com/OntologyToAPI-Communications/1.0.0> ,
                                          <http://www.cedri.com/OntologyToAPI-BusinessModel/1.0.0> ,
                                          <http://www.cedri.com/OntologyToAPI-ExternalCode/1.0.0> ;
                              <http://purl.org/dc/terms/description> "Describe what DBMMarketPricing does." .

#################################################################
#    Classes
#################################################################

DBMMarketPricing:DBMMarketPricing_Class rdf:type owl:Class ;
                    rdfs:subClassOf bm:BusinessModel ;
                    rdfs:comment "Describe the kind of business model DBMMarketPricing is." .

#################################################################
#    Individuals
#################################################################

# Endpoint Parameters (Expected Inputs)

DBMMarketPricing:ExampleInput rdf:type owl:NamedIndividual ,
                             bm:Parameter ;
                    bm:hasParameterLabel "ExampleInput" ;
                    bm:hasParameterType "float" .

# Expected Outputs (the types are used to match them with the inputs of other concepts)

DBMMarketPricing:status rdf:type owl:NamedIndividual ,
                       md:Metadata ;
              md:hasType "str" .

DBMMarketPricing:desc rdf:type owl:NamedIndividual ,
                     md:Metadata ;
            md:hasType "str" .

DBMMarketPricing:result rdf:type owl:NamedIndividual ,
                       md:Metadata ;
              md:hasType "float" .

# The Business Model (the concept shown in the platform)

DBMMarketPricing:DBMMarketPricing rdf:type owl:NamedIndividual ,
                       DBMMarketPricing:DBMMarketPricing_Class ;
              bm:hasExternalCode DBMMarketPricing:DBMMarketPricingFunction ;
              bm:hasParameter DBMMarketPricing:ExampleInput ;
              bm:hasOutputMetadata DBMMarketPricing:status ,
                                   DBMMarketPricing:desc ,
                                   DBMMarketPricing:result .

# External Code (the Python entry point)

DBMMarketPricing:DBMMarketPricingFunction rdf:type owl:NamedIndividual ,
                               excode:ExternalCode ;
                      excode:hasFunction "RunDBMMarketPricing" ;
                      excode:hasPythonFile "./UPB_pkg/MarketPricing/DBMMarketPricing.py" ;
                      excode:requiresLib "pydantic" .
