@base <http://www.cedri.com/WithoutP2P#> .

#################################################################
#    Prefixes
#################################################################

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Ontological framework
@prefix md:  <http://www.cedri.com/OntologyToAPI-Metadata#> .
@prefix comm:  <http://www.cedri.com/OntologyToAPI-Communications#> .
@prefix bm:  <http://www.cedri.com/OntologyToAPI-BusinessModel#> .
@prefix excode:  <http://www.cedri.com/OntologyToAPI-ExternalCode#> .
@prefix PlatformBuilder: <http://www.cedri.com/PlatformBuilder#> .

# This ontology
@prefix WithoutP2P: <http://www.cedri.com/WithoutP2P#> .

#################################################################
#    Ontology
#################################################################

<http://www.cedri.com/WithoutP2P> rdf:type owl:Ontology ;
                              owl:versionIRI <http://www.cedri.com/WithoutP2P/1.0.0> ;
                              owl:imports <http://www.cedri.com/OntologyToAPI-Metadata/1.0.0> ,
                                          <http://www.cedri.com/OntologyToAPI-Communications/1.0.0> ,
                                          <http://www.cedri.com/OntologyToAPI-BusinessModel/1.0.0> ,
                                          <http://www.cedri.com/OntologyToAPI-ExternalCode/1.0.0> ;
                              <http://purl.org/dc/terms/description> "Describe what WithoutP2P does." .

#################################################################
#    Classes
#################################################################

WithoutP2P:WithoutP2P_Class rdf:type owl:Class ;
                    rdfs:subClassOf bm:BusinessModel ;
                    rdfs:comment "Describe the kind of business model WithoutP2P is." .

#################################################################
#    Individuals
#################################################################

# Endpoint Parameters (Expected Inputs)

WithoutP2P:consumption_per_member rdf:type owl:NamedIndividual ,
                                    bm:Parameter ;
                            bm:hasParameterLabel "ConsumptionPerMember" ;
                            bm:hasParameterType "dict" .

WithoutP2P:generation_per_member rdf:type owl:NamedIndividual ,
                                    bm:Parameter ;
                            bm:hasParameterLabel "GenerationPerMember" ;
                            bm:hasParameterType "dict" .
                            
WithoutP2P:FixedPrice rdf:type owl:NamedIndividual ,
                             bm:Parameter ;
                    bm:hasParameterLabel "FixedPrice" ;
                    bm:hasParameterType "float" .

# Expected Outputs (the types are used to match them with the inputs of other concepts)

WithoutP2P:status rdf:type owl:NamedIndividual ,
                       md:Metadata ;
              md:hasType "str" .

WithoutP2P:desc rdf:type owl:NamedIndividual ,
                     md:Metadata ;
            md:hasType "str" .

WithoutP2P:result rdf:type owl:NamedIndividual ,
                       md:Metadata ;
              md:hasType "dict" .

# The Business Model (the concept shown in the platform)

WithoutP2P:WithoutP2P rdf:type owl:NamedIndividual ,
                       WithoutP2P:WithoutP2P_Class ;
              bm:hasExternalCode WithoutP2P:WithoutP2PFunction ;
              bm:hasParameter WithoutP2P:consumption_per_member, WithoutP2P:generation_per_member, WithoutP2P:FixedPrice  ;
              bm:hasOutputMetadata WithoutP2P:status ,
                                   WithoutP2P:desc ,
                                   WithoutP2P:result .

# External Code (the Python entry point)

WithoutP2P:WithoutP2PFunction rdf:type owl:NamedIndividual ,
                               excode:ExternalCode ;
                      excode:hasFunction "RunWithoutP2P" ;
                      excode:hasPythonFile "./UPB_pkg/Indicators/WithoutP2P.py" ;
                      excode:requiresLib "pydantic" .
