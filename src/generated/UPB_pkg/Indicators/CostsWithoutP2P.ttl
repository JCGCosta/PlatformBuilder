@base <http://www.cedri.com/CostsWithoutP2P#> .

#################################################################
#    Prefixes
#################################################################

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Ontological framework
@prefix md:  <http://www.cedri.com/OntologyToAPI-Metadata#> .
@prefix comm:  <http://www.cedri.com/OntologyToAPI-Communications#> .
@prefix bm:  <http://www.cedri.com/OntologyToAPI-BusinessModel#> .
@prefix excode:  <http://www.cedri.com/OntologyToAPI-ExternalCode#> .
@prefix PlatformBuilder: <http://www.cedri.com/PlatformBuilder#> .

# This ontology
@prefix CostsWithoutP2P: <http://www.cedri.com/CostsWithoutP2P#> .

#################################################################
#    Ontology
#################################################################

<http://www.cedri.com/CostsWithoutP2P> rdf:type owl:Ontology ;
                              owl:versionIRI <http://www.cedri.com/CostsWithoutP2P/1.0.0> ;
                              owl:imports <http://www.cedri.com/OntologyToAPI-Metadata/1.0.0> ,
                                          <http://www.cedri.com/OntologyToAPI-Communications/1.0.0> ,
                                          <http://www.cedri.com/OntologyToAPI-BusinessModel/1.0.0> ,
                                          <http://www.cedri.com/OntologyToAPI-ExternalCode/1.0.0> ;
                              <http://purl.org/dc/terms/description> "Describe what CostsWithoutP2P does." .

#################################################################
#    Classes
#################################################################

CostsWithoutP2P:CostsWithoutP2P_Class rdf:type owl:Class ;
                    rdfs:subClassOf bm:BusinessModel ;
                    rdfs:comment "Describe the kind of business model CostsWithoutP2P is." .

#################################################################
#    Individuals
#################################################################

# Endpoint Parameters (Expected Inputs)

CostsWithoutP2P:consumption_per_member rdf:type owl:NamedIndividual ,
                                    bm:Parameter ;
                            bm:hasParameterLabel "ConsumptionPerMember" ;
                            bm:hasParameterType "dict" .

CostsWithoutP2P:generation_per_member rdf:type owl:NamedIndividual ,
                                    bm:Parameter ;
                            bm:hasParameterLabel "GenerationPerMember" ;
                            bm:hasParameterType "dict" .
                            
CostsWithoutP2P:FixedPrice rdf:type owl:NamedIndividual ,
                             bm:Parameter ;
                    bm:hasParameterLabel "FixedPrice" ;
                    bm:hasParameterType "float" .

# Expected Outputs (the types are used to match them with the inputs of other concepts)

CostsWithoutP2P:status rdf:type owl:NamedIndividual ,
                       md:Metadata ;
              md:hasType "str" .

CostsWithoutP2P:desc rdf:type owl:NamedIndividual ,
                     md:Metadata ;
            md:hasType "str" .

CostsWithoutP2P:costs rdf:type owl:NamedIndividual ,
                       md:Metadata ;
              md:hasType "dict" .

# The Business Model (the concept shown in the platform)

CostsWithoutP2P:CostsWithoutP2P rdf:type owl:NamedIndividual ,
                       CostsWithoutP2P:CostsWithoutP2P_Class ;
              bm:hasExternalCode CostsWithoutP2P:CostsWithoutP2PFunction ;
              bm:hasParameter CostsWithoutP2P:consumption_per_member, CostsWithoutP2P:generation_per_member, CostsWithoutP2P:FixedPrice  ;
              bm:hasOutputMetadata CostsWithoutP2P:status ,
                                   CostsWithoutP2P:desc ,
                                   CostsWithoutP2P:costs .

# External Code (the Python entry point)

CostsWithoutP2P:CostsWithoutP2PFunction rdf:type owl:NamedIndividual ,
                               excode:ExternalCode ;
                      excode:hasFunction "RunCostsWithoutP2P" ;
                      excode:hasPythonFile "./UPB_pkg/Indicators/CostsWithoutP2P.py" ;
                      excode:requiresLib "pydantic" .
