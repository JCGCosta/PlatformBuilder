@base <http://www.cedri.com/ADMMOptimization#> .

#################################################################
#    Prefixes
#################################################################

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Ontological framework
@prefix md:  <http://www.cedri.com/OntologyToAPI-Metadata#> .
@prefix comm:  <http://www.cedri.com/OntologyToAPI-Communications#> .
@prefix bm:  <http://www.cedri.com/OntologyToAPI-BusinessModel#> .
@prefix excode:  <http://www.cedri.com/OntologyToAPI-ExternalCode#> .
@prefix PlatformBuilder: <http://www.cedri.com/PlatformBuilder#> .

# This ontology
@prefix ADMMOptimization: <http://www.cedri.com/ADMMOptimization#> .

#################################################################
#    Ontology
#################################################################

<http://www.cedri.com/ADMMOptimization> rdf:type owl:Ontology ;
                              owl:versionIRI <http://www.cedri.com/ADMMOptimization/1.0.0> ;
                              owl:imports <http://www.cedri.com/OntologyToAPI-Metadata/1.0.0> ,
                                          <http://www.cedri.com/OntologyToAPI-Communications/1.0.0> ,
                                          <http://www.cedri.com/OntologyToAPI-BusinessModel/1.0.0> ,
                                          <http://www.cedri.com/OntologyToAPI-ExternalCode/1.0.0> ;
                              <http://purl.org/dc/terms/description> "Describe what ADMMOptimization does." .

#################################################################
#    Classes
#################################################################

ADMMOptimization:ADMMOptimization_Class rdf:type owl:Class ;
                    rdfs:subClassOf bm:BusinessModel ;
                    rdfs:comment "Describe the kind of business model ADMMOptimization is." .

#################################################################
#    Individuals
#################################################################

# Endpoint Parameters (Expected Inputs)

ADMMOptimization:GammaOvertime rdf:type owl:NamedIndividual ,
                             bm:Parameter ;
                    bm:hasParameterLabel "GammaOvertime" ;
                    bm:hasParameterType "list[list]" .
                    
ADMMOptimization:FixedPrice rdf:type owl:NamedIndividual ,
                             bm:Parameter ;
                    bm:hasParameterLabel "FixedPrice" ;
                    bm:hasParameterType "float" .
                    
ADMMOptimization:consumption_per_member rdf:type owl:NamedIndividual ,
                                    bm:Parameter ;
                            bm:hasParameterLabel "ConsumptionPerMember" ;
                            bm:hasParameterType "dict" .

ADMMOptimization:generation_per_member rdf:type owl:NamedIndividual ,
                                    bm:Parameter ;
                            bm:hasParameterLabel "GenerationPerMember" ;
                            bm:hasParameterType "dict" .

# Expected Outputs (the types are used to match them with the inputs of other concepts)

ADMMOptimization:status rdf:type owl:NamedIndividual ,
                       md:Metadata ;
              md:hasType "str" .

ADMMOptimization:desc rdf:type owl:NamedIndividual ,
                     md:Metadata ;
            md:hasType "str" .
              
ADMMOptimization:aggred_p2p_trades_kwh rdf:type owl:NamedIndividual ,
                       md:Metadata ;
              md:hasType "list[list]" .
              
ADMMOptimization:grid_exchanges_per_member_kwh rdf:type owl:NamedIndividual ,
                       md:Metadata ;
              md:hasType "list[list]" .

ADMMOptimization:energy_shadow_price_euro_per_kwh rdf:type owl:NamedIndividual ,
                       md:Metadata ;
              md:hasType "list[list]" .
              
ADMMOptimization:aggreament_condition_multiplier rdf:type owl:NamedIndividual ,
                       md:Metadata ;
              md:hasType "list[list]" .
              
ADMMOptimization:iterations_per_timestep rdf:type owl:NamedIndividual ,
                       md:Metadata ;
              md:hasType "list[int]" .

# The Business Model (the concept shown in the platform)

ADMMOptimization:ADMMOptimization rdf:type owl:NamedIndividual ,
                       ADMMOptimization:ADMMOptimization_Class ;
              bm:hasExternalCode ADMMOptimization:ADMMOptimizationFunction ;
              bm:hasParameter ADMMOptimization:GammaOvertime,  ADMMOptimization:consumption_per_member, ADMMOptimization:generation_per_member, ADMMOptimization:FixedPrice ;
              bm:hasOutputMetadata ADMMOptimization:status ,
                                   ADMMOptimization:desc ,
                                   ADMMOptimization:aggred_p2p_trades_kwh,
                                   ADMMOptimization:grid_exchanges_per_member_kwh,
                                   ADMMOptimization:energy_shadow_price_euro_per_kwh,
                                   ADMMOptimization:aggreament_condition_multiplier,
                                   ADMMOptimization:iterations_per_timestep .

# External Code (the Python entry point)

ADMMOptimization:ADMMOptimizationFunction rdf:type owl:NamedIndividual ,
                               excode:ExternalCode ;
                      excode:hasFunction "RunADMMOptimization" ;
                      excode:hasPythonFile "./UPB_pkg/ADMMOptimization/ADMMOptimization.py" ;
                      excode:requiresLib "pydantic" .
