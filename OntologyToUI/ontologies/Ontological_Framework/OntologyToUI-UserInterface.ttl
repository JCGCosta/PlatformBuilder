@prefix : <http://www.cedri.com/SmartLEM-UserInterface#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

@prefix md:  <http://www.cedri.com/OntologyToAPI-Metadata#> .
@prefix bm:  <http://www.cedri.com/OntologyToAPI-BusinessModel#> .

@base <http://www.cedri.com/SmartLEM-UserInterface#> .

<http://www.cedri.com/SmartLEM-UserInterface> rdf:type owl:Ontology ;
                                               owl:versionIRI <http://www.cedri.com/SmartLEM-UserInterface/1.0.0> ;
                                               owl:imports  <http://www.cedri.com/SmartLEM-Metadata/1.0.0> ,
                                                            <http://www.cedri.com/OntologyToAPI-BusinessModel/1.0.0>;
                                               <http://purl.org/dc/terms/creator> "https://orcid.org/0000-0002-7620-0960" ;
                                               <http://purl.org/dc/terms/description> "This ontology represent the abstract user interface concepts." ;
                                               <http://purl.org/dc/terms/issued> "2025-06-30" ;
                                               <http://purl.org/dc/terms/modified> "2025-06-30" .


#################################################################
#    Classes
#################################################################

###  http://www.cedri.com/SmartLEM-UserInterface#BarPlot
:BarPlot rdf:type owl:Class ;
         rdfs:subClassOf :Graph .


###  http://www.cedri.com/SmartLEM-UserInterface#CircularPlot
:CircularPlot rdf:type owl:Class ;
              rdfs:subClassOf :Graph .


###  http://www.cedri.com/SmartLEM-UserInterface#Graph
:Graph rdf:type owl:Class .


###  http://www.cedri.com/SmartLEM-UserInterface#Image
:Image rdf:type owl:Class .


###  http://www.cedri.com/SmartLEM-UserInterface#Table
:Table rdf:type owl:Class .

###  http://www.cedri.com/SmartLEM-UserInterface#Label
:Label rdf:type owl:Class ;
       rdfs:comment "A unified text component. Use hasType to specify rendering: 'title', 'paragraph', or 'label'." .

###  http://www.cedri.com/SmartLEM-UserInterface#Form
:Form rdf:type owl:Class ;
      rdfs:comment "A form component that generates input fields based on a BusinessModel's parameters." .


###  http://www.cedri.com/SmartLEM-UserInterface#LinePlot
:LinePlot rdf:type owl:Class ;
          rdfs:subClassOf :Graph .


###  http://www.cedri.com/SmartLEM-UserInterface#Page
:Page rdf:type owl:Class .

###  http://www.cedri.com/SmartLEM-UserInterface#LiveTable
:LiveTable rdf:type owl:Class ;
           rdfs:comment "A live table that connects to a WebSocket/Socket.IO source and displays real-time streaming data without requiring a form submission." .


#################################################################
#    Object Properties
#################################################################

###  http://www.cedri.com/SmartLEM-UserInterface#hasDependentMetadata
:hasDependentMetadata rdf:type owl:ObjectProperty ;
                      rdfs:domain :Graph ;
                      rdfs:range md:Metadata .


###  http://www.cedri.com/SmartLEM-UserInterface#hasGraphicRepresentation
:hasGraphicRepresentation rdf:type owl:ObjectProperty ;
                          rdfs:range :Graph ,
                                     :Image ,
                                     :Label ,
                                     :Form ,
                                     :Table .


###  http://www.cedri.com/SmartLEM-UserInterface#hasIndependentMetadata
:hasIndependentMetadata rdf:type owl:ObjectProperty ;
                        rdfs:domain :Graph ;
                        rdfs:range md:Metadata .


###  http://www.cedri.com/SmartLEM-UserInterface#hasMetadata
:hasMetadata rdf:type owl:ObjectProperty ;
             rdfs:domain :Image ,
                         :Label ;
             rdfs:range md:Metadata .

###  http://www.cedri.com/SmartLEM-UserInterface#hasBusinessModel
:hasBusinessModel rdf:type owl:ObjectProperty ;
             rdfs:domain :Image ,
                         :Label ,
                         :Table ,
                         :Graph ,
                         :Form ;
             rdfs:range bm:BusinessModel .


#################################################################
#    Data properties
#################################################################

###  http://www.cedri.com/SmartLEM-UserInterface#hasLegendPosition
:hasLegendPosition rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :Graph ;
                   rdfs:range xsd:string .

###  http://www.cedri.com/SmartLEM-UserInterface#hasXAxisLabel
:hasXAxisLabel rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Graph ;
               rdfs:range xsd:string ;
               rdfs:comment "Label for the X axis of a graph (e.g., 'Time', 'Date')." .

###  http://www.cedri.com/SmartLEM-UserInterface#hasYAxisLabel
:hasYAxisLabel rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Graph ;
               rdfs:range xsd:string ;
               rdfs:comment "Label for the Y axis of a graph (e.g., 'Temperature (°C)')." .

###  http://www.cedri.com/SmartLEM-UserInterface#hasSeriesLabel
:hasSeriesLabel rdf:type owl:DatatypeProperty ;
                rdfs:domain md:Metadata ;
                rdfs:range xsd:string ;
                rdfs:comment "Display label for a data series in a graph legend (e.g., 'Temperature (°C)')." .

###  http://www.cedri.com/SmartLEM-UserInterface#hasSeriesAlias
:hasSeriesAlias rdf:type owl:DatatypeProperty ;
                rdfs:domain :Graph ;
                rdfs:range xsd:string ;
                rdfs:comment "Series alias mapping in the format '<MetadataLocalName>=<Display Label>'. Repeat the property for multiple series." .

###  http://www.cedri.com/SmartLEM-UserInterface#hasJsonKey
:hasJsonKey rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain md:Metadata ;
            rdfs:range xsd:string ;
            rdfs:comment "The JSON key name returned by the API for this metadata field." .


###  http://www.cedri.com/SmartLEM-UserInterface#hasTitle
:hasTitle rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :Graph ,
                      :Form ,
                      :Table ,
                      :LiveTable ;
          rdfs:range xsd:string .

###  http://www.cedri.com/SmartLEM-UserInterface#hasWebSocketUrl
:hasWebSocketUrl rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :LiveTable ;
                 rdfs:range xsd:string ;
                 rdfs:comment "The Socket.IO server URL (e.g., 'http://127.0.0.1:5001')." .

###  http://www.cedri.com/SmartLEM-UserInterface#hasEventName
:hasEventName rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :LiveTable ;
              rdfs:range xsd:string ;
              rdfs:comment "The Socket.IO event name to subscribe to (e.g., 'new_message')." .

###  http://www.cedri.com/SmartLEM-UserInterface#hasTopicFilter
:hasTopicFilter rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :LiveTable ;
                rdfs:range xsd:string ;
                rdfs:comment "MQTT-style topic filter to select which messages to display (e.g., 'clients/+/data'). Supports + (single level) wildcard." .

###  http://www.cedri.com/SmartLEM-UserInterface#hasColumnMetadata
:hasColumnMetadata rdf:type owl:ObjectProperty ;
                   rdfs:domain :Table ;
                   rdfs:range md:Metadata ;
                   rdfs:comment "Specifies which metadata fields to display as columns in a Table. Repeat for each column." .

###  http://www.cedri.com/SmartLEM-UserInterface#hasText
:hasText rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :Label ;
          rdfs:range xsd:string .

###  http://www.cedri.com/SmartLEM-UserInterface#hasLevel
:hasLevel rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :Label ;
          rdfs:range xsd:integer ;
          rdfs:comment "The heading level (1-5) for Label with hasType 'title'." .

###  http://www.cedri.com/SmartLEM-UserInterface#hasType
:hasType rdf:type owl:DatatypeProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain :Label ;
         rdfs:range xsd:string ;
         rdfs:comment "The visual type of a Label: 'title', 'paragraph', or 'label'." .

###  http://www.cedri.com/SmartLEM-UserInterface#hasImageSrc
:hasImageSrc rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Image ;
             rdfs:range xsd:string ;
             rdfs:comment "Path to the static image file served from /public (e.g., '/img/logo.png')." .

###  http://www.cedri.com/SmartLEM-UserInterface#hasImageAlt
:hasImageAlt rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Image ;
             rdfs:range xsd:string ;
             rdfs:comment "Accessible alt text for the image." .

###  http://www.cedri.com/SmartLEM-UserInterface#hasWidth
:hasWidth rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :Image ;
          rdfs:range xsd:string ;
          rdfs:comment "CSS width of the image (e.g., '500px', '70%')." .

###  http://www.cedri.com/SmartLEM-UserInterface#hasHeight
:hasHeight rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :Image ;
           rdfs:range xsd:string ;
           rdfs:comment "CSS height of the image (e.g., '100px')." .

###  http://www.cedri.com/SmartLEM-UserInterface#hasAlignment
:hasAlignment rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Image ;
              rdfs:range xsd:string ;
              rdfs:comment "Horizontal alignment of the image wrapper: 'left', 'center', or 'right'." .

###  http://www.cedri.com/SmartLEM-UserInterface#hasGroup
:hasGroup rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :Image ;
          rdfs:range xsd:string ;
          rdfs:comment "Group identifier for side-by-side layout. Images sharing the same group are rendered in a flex row, ordered by ui:order." .

###  http://www.cedri.com/SmartLEM-UserInterface#hasBorderRadius
:hasBorderRadius rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :Image ;
                 rdfs:range xsd:string ;
                 rdfs:comment "CSS border-radius for the image (e.g., '12px')." .


